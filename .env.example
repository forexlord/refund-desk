# Copy to .env and fill in. docker compose reads .env automatically.

# Anthropic API key. Leave empty to run in fallback mode (keyword classifier + reply templates).
ANTHROPIC_API_KEY=

# Any Anthropic model that supports tool use.
ANTHROPIC_MODEL=claude-sonnet-5

# Timeout for each model call, in ms. The request falls back rather than hanging.
AI_TIMEOUT_MS=20000

# HMAC key for session cookies. Leave empty for a random key per start (everyone is signed out on restart).
SESSION_SECRET=

# Set to true when served over HTTPS so the session cookie gets the Secure flag.
COOKIE_SECURE=false

# Demo only: the sign-in pages offer a picker of the synthetic seeded accounts that fills email + password.
# Sign-in still checks the password. Set to false for anything other than a local demo.
DEMO_ACCOUNTS=true

# Demo only: no email provider is configured, so the agent's one-time sign-in code is returned by the
# login API and shown on the sign-in page. Set to false once a real mailer is wired in.
EXPOSE_OTP=true

# Public URL of the web app, used in password-reset links.
APP_URL=http://localhost:3000
